{
  "allowCompoundWords": true,
  "language": "en_US",
  "dictionaries": [
    "bash",
    "companies",
    "css",
    "html",
    "misc",
    "softwareTerms",
    "npm",
    "typescript"
  ],
  "ignorePaths": [
    ".vscode/",
    ".idea/",
    "**/node_modules/**",
    "**/*.lock",
    "package.json",
    "website/api.json",
    "website/docs/assets/**",
    "website/site*/**",
    "website/tools/example-check/go.sum"
  ],
  "ignoreRegExpList": [
    "/\\|\\s+[T|G]{2,}\\s+\\|/g",
    "/https?:\\/\\/.*/g",
    "/github.*/g"
  ],
  "overrides": [
    {
      "filename": [
        "website/**",
        "cspell.json"
      ],
      "words": [
        "Filip",
        "Fong",
        "Moyer",
        "Pawel",
        "Piwowarczyk",
        "Rusakiewicz",
        "Weyert",
        "govy",
        "govydoc",
        "inlinehilite",
        "linenums",
        "openslosdk",
        "pydantic",
        "pygments",
        "pymdownx",
        "sloconf"
      ]
    }
  ],
  "words": [
    "Kubernetes",
    "devbox",
    "direnv",
    "envrc",
    "mkdocs",
    "openslo",
    "slos",
    "tada",
    "venv"
  ]
}